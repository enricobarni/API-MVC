
@model Contatos.Models.ContatoViewModel
@{
    ViewData["Title"] = "Cadastro de Contatos";
}

<h2>Cadastro de Contatos</h2>

<form method="post">
    <table class="form-table">

        <tr>
            <td><label>Nome:</label></td>
            <td>
                <input type="text"
                       name="NovoContato.Nome"
                       value="@Model.NovoContato.Nome"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>E-Mail:</label></td>
            <td>
                <input type="email"
                       name="NovoContato.Email"
                       value="@Model.NovoContato.Email"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>Celular:</label></td>
            <td>
                <input type="text"
                       id="celular"
                       name="NovoContato.Celular"
                       value="@Model.NovoContato.Celular"
                       maxlength="15"
                       placeholder="(00) 00000-0000"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>Data de nascimento:</label></td>
            <td>
                <input type="date"
                       name="NovoContato.Nascimento"
                       value="@Model.NovoContato.Nascimento"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>CPF:</label></td>
            <td>
                <input type="text"
                       id="cpf"
                       name="NovoContato.CPF"
                       value="@Model.NovoContato.CPF"
                       maxlength="14"
                       placeholder="000.000.000-00"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align:center">

                <button class="btn btn-outline-secondary btn-sm"
                        type="submit">
                    Adicionar
                </button>

                &nbsp;&nbsp;

                <button class="btn btn-outline-secondary btn-sm"
                        type="button"
                        onclick="window.location='/Home/Index'">
                    Sair
                </button>

            </td>
        </tr>

    </table>
</form>

<hr />

<h3>Contatos cadastrados</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>E-Mail</th>
            <th>Celular</th>
            <th>Data de Nascimento</th>
            <th>CPF</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Contatos.Models.ContatoModel c in Model.ListaContatos)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nome</td>
                <td>@c.Email</td>
                <td>@c.Celular</td>
                <td>@c.Nascimento</td>
                <td>@c.CPF</td>
            </tr>
        }
    </tbody>
</table>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Email)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Nome)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Nascimento)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.CPF)
</div>


<script>

    // MÁSCARA DO CPF
    document.getElementById("cpf").addEventListener("input", function (e) {

        let valor = e.target.value.replace(/\D/g, "");

        valor = valor.substring(0, 11);

        if (valor.length > 9) {
            valor = valor.replace(
                /(\d{3})(\d{3})(\d{3})(\d{0,2})/,
                "$1.$2.$3-$4"
            );
        }
        else if (valor.length > 6) {
            valor = valor.replace(
                /(\d{3})(\d{3})(\d{0,3})/,
                "$1.$2.$3"
            );
        }
        else if (valor.length > 3) {
            valor = valor.replace(
                /(\d{3})(\d{0,3})/,
                "$1.$2"
            );
        }

        e.target.value = valor;
    });


    // MÁSCARA DO CELULAR
    document.getElementById("celular").addEventListener("input", function (e) {

        let valor = e.target.value.replace(/\D/g, "");

        valor = valor.substring(0, 11);

        if (valor.length > 10) {
            valor = valor.replace(
                /(\d{2})(\d{5})(\d{4})/,
                "($1) $2-$3"
            );
        }

        e.target.value = valor;
    });

</script>
