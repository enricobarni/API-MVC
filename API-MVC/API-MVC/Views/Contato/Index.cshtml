@model Contatos.Models.ContatoViewModel
@{
    ViewData["Title"] = "Cadastro de Contatos";
}

<h2>Cadastro de Contatos</h2>

<form method="post">
    <table class="form-table">

        <tr>
            <td><label>Nome:</label></td>
            <td>
                <input type="text"
                       name="NovoContato.Nome"
                       value="@Model.NovoContato.Nome"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>E-Mail:</label></td>
            <td>
                <input type="email"
                       name="NovoContato.Email"
                       value="@Model.NovoContato.Email"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>Celular:</label></td>
            <td>
                <input type="text"
                       id="celular"
                       name="NovoContato.Celular"
                       value="@Model.NovoContato.Celular"
                       maxlength="15"
                       placeholder="(00) 00000-0000"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>Data de nascimento:</label></td>
            <td>
                <input type="date"
                       name="NovoContato.Nascimento"
                       value="@Model.NovoContato.Nascimento"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td><label>CPF:</label></td>
            <td>
                <input type="text"
                       id="cpf"
                       name="NovoContato.CPF"
                       value="@Model.NovoContato.CPF"
                       maxlength="14"
                       placeholder="000.000.000-00"
                       style="width:300px" />
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align:center">

                <button class="btn btn-outline-secondary btn-sm"
                        type="submit">
                    Adicionar
                </button>

                &nbsp;&nbsp;

                <button class="btn btn-outline-secondary btn-sm"
                        type="button"
                        onclick="window.location='/Home/Index'">
                    Sair
                </button>

            </td>
        </tr>

    </table>
    <table style="width:100%">
        <tr>
            <td style="width:5%">&nbsp;</td>
            <td>
                <span>Busca por ID</span>
            </td>
            <td>
                <input type="number" name="NovoContato.idBusca" style="width=200%" value="@Model.NovoContato.IdBusca" />
            </td>
            <td>
                <button type="submit">Buscar</button>
            </td>
            <td style="width:5%">&nbsp;</td>
        </tr>
    </table>
</form>

<hr />

<h3>Contatos cadastrados</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <td>
                @Html.ActionLink("Id", "Ordena", new { nome = "id"},
                new {title = "Clique para ordenar a lista por Id!", @class = "meuLink"})
            </td>
            <td>
                @Html.ActionLink("Nome", "Ordena", new { nome = "nome"},
                new {title = "Clique para ordenar a lista por nome!", @class = "meuLink"})
            </td>
            <td>
                @Html.ActionLink("E-mail", "Ordena", new { nome = "email"},
                new {title = "Clique para ordenar a lista por e-mail!", @class = "meuLink"})
            </td>
            <td>
                @Html.ActionLink("Celular", "Ordena", new { nome = "celular"},
                new {title = "Clique para ordenar a lista por celular!", @class = "meuLink"})
            </td>
            <td>
                @Html.ActionLink("Nascimento", "Ordena", new { nome = "nascimento"},
                new {title = "Clique para ordenar a lista por data de nascimento!", @class = "meuLink"})
            </td>
            <td>
                @Html.ActionLink("CPF", "Ordena", new { nome = "cpf"},
                new {title = "Clique para ordenar a lista por CPF!", @class = "meuLink"})
            </td>
        </tr>
    </thead>

    <tbody>
        @foreach (Contatos.Models.ContatoModel c in Model.ListaContatos)
        {
         <tr class="@(c.Id.Equals(Model.selecaoId) ? " linha-selecionada" : "" )">

            <td>@c.Id</td>
            <td>@c.Nome</td>
            <td>@c.Email</td>
            <td>
                @(!String.IsNullOrWhiteSpace(c.Celular) ?
                string.Format("{0:(##) # ####-####}", long.Parse(c.Celular.Where(char.IsDigit).ToArray())) : " - ")
            </td>
            <td>
                @(!String.IsNullOrWhiteSpace(c.Telefone) ?
                string.Format("{0:(##) # ####-####}", long.Parse(c.Telefone.Where(char.IsDigit).ToArray())) : " - ")
            </td>
            <td>
                @(String.Format("{0:00#-###-###/##}", long.Parse((c.CPF+"").Where(char.IsDigit).ToArray())))
            </td>
            <td>
                @c.Nascimento.ToString("dd/MM/yyyy")
            </td>
        </tr>

        }
    </tbody>
</table>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Email)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Nome)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.Nascimento)
</div>

<div class="validation">
    @Html.ValidationMessageFor(m => m.NovoContato.CPF)
</div>


<script>

    // MÁSCARA DO CPF
    document.getElementById("cpf").addEventListener("input", function (e) {

        let valor = e.target.value.replace(/\D/g, "");

        valor = valor.substring(0, 11);

        if (valor.length > 9) {
            valor = valor.replace(
                /(\d{3})(\d{3})(\d{3})(\d{0,2})/,
                "$1.$2.$3-$4"
            );
        }
        else if (valor.length > 6) {
            valor = valor.replace(
                /(\d{3})(\d{3})(\d{0,3})/,
                "$1.$2.$3"
            );
        }
        else if (valor.length > 3) {
            valor = valor.replace(
                /(\d{3})(\d{0,3})/,
                "$1.$2"
            );
        }

        e.target.value = valor;
    });


    // MÁSCARA DO CELULAR
    document.getElementById("celular").addEventListener("input", function (e) {

        let valor = e.target.value.replace(/\D/g, "");

        valor = valor.substring(0, 11);

        if (valor.length > 10) {
            valor = valor.replace(
                /(\d{2})(\d{5})(\d{4})/,
                "($1) $2-$3"
            );
        }

        e.target.value = valor;
    });

</script>
